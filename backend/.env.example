# Copy to .env (or export in your shell) and adjust. Everything has a sane
# default; secrets stay in env, never in code or the DB.

# --- Core ---
# STOCKS_DB_PATH=stocks.db
# STOCKS_LOG_LEVEL=INFO
# STOCKS_REFRESH_SECONDS=180

# --- Web security ---
# Comma-separated browser origins allowed to call the API (no wildcard —
# cookies ride on these requests).
# STOCKS_CORS_ORIGINS=http://localhost:5173
# Set to 1 when serving over HTTPS so session cookies are marked Secure.
# STOCKS_COOKIE_SECURE=0
# STOCKS_SESSION_TTL_SECONDS=1209600       # active session lifetime (14 days)
# STOCKS_PENDING_SESSION_TTL_SECONDS=300   # password-ok -> TOTP window
# IPs whose X-Forwarded-For is believed, for rate limiting. Only ever a proxy
# terminating TLS on this machine (Tailscale Funnel, nginx, Caddy). Also handed
# to uvicorn's ProxyHeadersMiddleware by run_server.py.
# STOCKS_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Strict-Transport-Security max-age; 0 disables. Only sent on requests that
# really arrived over HTTPS -- see config.py for why that guard matters.
# STOCKS_HSTS_SECONDS=0
# Who may create an account: open | invite | closed. Being reachable and being
# open for signup are separate decisions (app/registration.py).
# STOCKS_REGISTRATION=open
# Required when STOCKS_REGISTRATION=invite; the app refuses to boot without it.
# STOCKS_INVITE_CODE=

# --- Data sources ---
# SEC requires a descriptive User-Agent with contact info for fair access.
# STOCKS_SEC_USER_AGENT="Signal Dashboard you@example.com"
# Optional Alpha Vantage key (primary for technicals; Yahoo fallback if unset).
# STOCKS_ALPHA_VANTAGE_KEY=

# --- Economic calendar ---
# Optional Financial Modeling Prep key. When set, the calendar uses FMP's
# official Low/Medium/High impact ratings; unset falls back to Nasdaq's keyless
# endpoint with our own curated importance classification.
# STOCKS_FMP_KEY=
# STOCKS_ECON_CALENDAR_DAYS_AHEAD=7
# STOCKS_ECON_CALENDAR_DAYS_BACK=1
# STOCKS_ECON_CALENDAR_MIN_INTERVAL_SECONDS=3600
# Comma-separated country allowlist (empty string keeps every country).
# STOCKS_ECON_CALENDAR_COUNTRIES=United States

# --- X (Twitter) watcher ---
# Accounts to monitor (comma-separated, without the @).
# STOCKS_X_ACCOUNTS=realDonaldTrump,aistocksavvy
# Official X API v2 bearer token. When set, the source uses the official API and
# is stamped "ok". When unset, it falls back to unofficial Nitter-style RSS
# mirrors: the posts are still stored, but the source is flagged as an
# error-style warning until an official key is configured.
# STOCKS_X_BEARER=
# Nitter-style mirror base URLs (RSS served at {mirror}/{account}/rss).
# STOCKS_X_MIRRORS=https://nitter.net,https://nitter.poast.org,https://nitter.privacydev.net
# STOCKS_X_POSTS_LIMIT=30
# STOCKS_X_MIN_INTERVAL_SECONDS=900

# --- Email digest (SMTP; works with a Gmail app password) ---
# STOCKS_SMTP_HOST=
# STOCKS_SMTP_PORT=587
# STOCKS_SMTP_USER=
# STOCKS_SMTP_PASSWORD=
# STOCKS_SMTP_FROM=

# --- SMS digest (Twilio) ---
# STOCKS_TWILIO_ACCOUNT_SID=
# STOCKS_TWILIO_AUTH_TOKEN=
# STOCKS_TWILIO_FROM_PHONE=

# --- Congress trades: House Clerk PTR filings ---
# PDFs read per run (each filing once); where pdftotext (poppler) is when it
# isn't on PATH, e.g. C:\poppler\Library\bin\pdftotext.exe for the service.
# STOCKS_CONGRESS_PTR_PER_RUN=25
# STOCKS_PDFTOTEXT=

# --- Famous investors' 13F holdings (SEC EDGAR; uses STOCKS_SEC_USER_AGENT) ---
# Narrow the built-in filer list to these CIKs; empty keeps all of them.
# STOCKS_13F_FILERS=1067983,1336528

# --- Alpaca broker (optional; paper account) ---
# Paper keys from alpaca.markets. One account per instance, owned by
# STOCKS_ALPACA_OWNER (an email; default the first admin). Live trading is
# refused until the per-order authenticator step exists.
# STOCKS_ALPACA_KEY_ID=
# STOCKS_ALPACA_SECRET_KEY=
# STOCKS_ALPACA_PAPER=1
# STOCKS_ALPACA_OWNER=
# STOCKS_ALPACA_RECONCILE_SECONDS=900

# --- Telegram bot (optional; no-ops while unset) ---
# Token from @BotFather. Alerts and bot fills go to chats linked in
# Settings → Telegram; the bot answers read-only commands.
# STOCKS_TELEGRAM_BOT_TOKEN=
# STOCKS_TELEGRAM_POLL_SECONDS=5

# --- Trading bot: costs, demo bots, paper account, exits ---
# One cost model for suggestions' net returns, paper fills, bot fills and
# the bar backtester (basis points each side).
# STOCKS_COST_BPS_PER_SIDE=10
# STOCKS_BOT_COST_BPS=10            # bot-only override; defaults to the above
# STOCKS_BOT_MAX_BOTS=10
# STOCKS_BOT_INTERVAL_SECONDS=60
# STOCKS_EXITS_INTERVAL_SECONDS=60  # exit rules + resting paper orders
# A quote older than this is never traded on (default 2 × the bot interval).
# STOCKS_ENGINE_QUOTE_MAX_AGE_SECONDS=120
# STOCKS_PAPER_START_CASH=100000
# STOCKS_PAPER_START_CURRENCY=USD
# Benchmarks for analytics, the regime gate and beta.
# STOCKS_BENCHMARKS=SPY,^TA125.TA
# Hit rates below this many outcomes are shown as "not enough data yet".
# STOCKS_MIN_TRACK_SAMPLE=30

# --- Market regime (risk-on / neutral / risk-off) ---
# STOCKS_REGIME_VIX_RISK_ON=16
# STOCKS_REGIME_VIX_RISK_OFF=25
# STOCKS_REGIME_VIX_TREND_PCT=20
# STOCKS_REGIME_FG_RISK_OFF=25
# STOCKS_REGIME_FG_RISK_ON=55
# STOCKS_REGIME_PC_RISK_OFF=1.0
# STOCKS_REGIME_PC_RISK_ON=0.8
# STOCKS_REGIME_CURVE_RISK_ON=0.25
# STOCKS_REGIME_SPY_MA_DAYS=200
# STOCKS_REGIME_MIN_INPUTS=3
# STOCKS_REGIME_SCORE_THRESHOLD=2
# STOCKS_REGIME_MAX_INPUT_AGE_DAYS=10

# --- Signal auto-mute (rolling hit rate per Boom Score component) ---
# STOCKS_SIGNAL_WINDOW_DAYS=30
# STOCKS_SIGNAL_MUTE_BELOW=40
# STOCKS_SIGNAL_MUTE_MIN_N=12
# STOCKS_SIGNAL_UNMUTE_MARGIN=5

# --- Rule backtester: full adjusted daily history ---
# STOCKS_DAILY_MAX_REFRESH_DAYS=7
# STOCKS_DAILY_MAX_PER_RUN=10

# --- Market-wide scanner ---
# Union of: majors, mine (held + watched), sp500, ndx100, ta125.
# STOCKS_SCANNER_UNIVERSES=majors,mine
# STOCKS_SCANNER_MAX_TICKERS=600
# STOCKS_SCANNER_INTERVAL_SECONDS=300
# STOCKS_SCANNER_QUOTE_BATCH=150
# STOCKS_SCANNER_HISTORY_PER_RUN=40
# STOCKS_SCANNER_HISTORY_MAX_AGE_HOURS=18
# STOCKS_SCANNER_RVOL_MIN=2.0
# STOCKS_SCANNER_GAP_PCT=3.0
# STOCKS_SCANNER_ALERTS_PER_HOUR=3   # default cap for users who opt in
# Server-sent events: each /api/stream connection ends after this long.
# STOCKS_STREAM_MAX_SECONDS=300

# --- Social login (OAuth; optional, each provider no-ops when unset) ---
# Mandatory TOTP 2FA still applies after social login. Register each app's
# callback as {REDIRECT_BASE}/api/auth/oauth/{provider}/callback.
# STOCKS_OAUTH_REDIRECT_BASE=http://localhost:8000
# STOCKS_OAUTH_GITHUB_CLIENT_ID=
# STOCKS_OAUTH_GITHUB_CLIENT_SECRET=
# STOCKS_OAUTH_GOOGLE_CLIENT_ID=
# STOCKS_OAUTH_GOOGLE_CLIENT_SECRET=
# STOCKS_OAUTH_FACEBOOK_CLIENT_ID=
# STOCKS_OAUTH_FACEBOOK_CLIENT_SECRET=
